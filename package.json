{
  "name": "forja",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=9 <11"
  },
  "scripts": {
    "dev": "wrangler dev",
    "version:write": "node -e \"require('fs').writeFileSync('.bot-version', require('./package.json').version + '\\n')\"",
    "deploy-check": "tsx scripts/deploy-check.ts",
    "predeploy": "pnpm deploy-check && pnpm version:write",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test",
    "check:ci": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:coverage",
    "quality:fix": "corepack pnpm lint:fix && corepack pnpm format",
    "security:audit": "corepack pnpm audit --audit-level high",
    "db:apply": "wrangler d1 execute horizontes_bot_db --file=src/db/schema.sql",
    "db:apply:remote": "wrangler d1 execute horizontes_bot_db --file=src/db/schema.sql --remote",
    "kb:reindex": "tsx scripts/generate-fixtures.ts",
    "eval": "tsx scripts/eval-bot-live.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.68",
    "@ai-sdk/xai": "^3.0.106",
    "agents": "^0.1.0",
    "ai": "^6.0.0",
    "hono": "^4.12.32",
    "resend": "^6.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260625.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "miniflare": "4.20260426.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.86.0"
  }
}
